{
  "minimum-stability": "dev",
  "require": {
    "craftcms/cloud": "2.x-dev",
    "craftcms/cms": "5.x-dev",
    "putyourlightson/craft-datastar": "^1.0.0-beta.1",
    "putyourlightson/craft-datastar-module": "dev-develop as 1.0.0-beta.4",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "2.x-dev",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "repositories": {
    "local": {
      "type": "path",
      "url": "/tmp/packages/*",
      "options": {
        "symlink": true
      }
    }
  }
}
